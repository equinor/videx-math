{
  "name": "@equinor/videx-math",
  "version": "1.1.12",
  "description": "A library with math used by Videx.",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prebuild": "node scripts/remove.mjs dist",
    "build": "rollup -c",
    "prepub": "npm run build",
    "pub": "npm publish --access=public",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "predocs": "node scripts/remove.mjs docs",
    "docs": "typedoc --out docs src",
    "postdocs": "node scripts/copy_docs_assets.mjs",
    "prettier": "prettier . --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equinor/videx-math.git"
  },
  "keywords": [
    "math"
  ],
  "author": "Tom Kristian Tjemsland",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/equinor/videx-math/issues"
  },
  "homepage": "https://github.com/equinor/videx-math#readme",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "rollup": "^4.60.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.18",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
